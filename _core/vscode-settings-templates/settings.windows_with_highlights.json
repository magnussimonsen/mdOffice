{
    "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
    "emeraldwalk.runonsave": {
        "isEnabled": true,
        "commands": [
            {
                "match": ".*",
                "cmd": "echo '${fileBasename}' saved."
            },
            {
                "match": ".*\\.md$",
                "cmd": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\" \"${workspaceFolder}/_core/scripts/mdoffice.py\" build-all \"${file}\""
            },
            {
                "match": ".*\\.md$",
                "cmd": "\"${workspaceFolder}\\.venv\\Scripts\\python.exe\" \"${workspaceFolder}/_core/scripts/mdoffice.py\" build-ai-instructions \"${file}\""
            }
        ]
    },
    "highlight.regexes": {
        "(:::[ \\t]*(?:\\{\\.)?(?:solution|blankbox)\\b[^\\n]*)((?:.|\\n)*?)(^:::[ \\t]*$)": {
            "filterFileRegex": ".*\\.(md)$",
            "regexFlags": "gm",
            "decorations": [
                {
                    "light": {
                        "fontWeight": "bold",
                        "color": "black",
                    },
                    "dark": {
                        "fontWeight": "bold",
                        "color": "white",
                    },
                    "isWholeLine": true
                },
                {
                    "light": {
                        "borderColor": "lightgray",
                    },
                    "dark": {
                        "borderColor": "#555555",
                    },
                    "isWholeLine": true,
                    "borderStyle": "solid",
                    "borderWidth": "0 0 0 10px",
                },
                {
                    "light": {
                        "fontWeight": "bold",
                        "color": "black"
                    },
                    "dark": {
                        "fontWeight": "bold",
                        "color": "white"
                    },
                    "isWholeLine": true
                }
            ]
        },
        "(\\\\begin\\{(?:align|align\\*|equation|equation\\*|gather|gather\\*|multline|multline\\*|cases|center)\\})([\\s\\S]*?)(\\\\end\\{(?:align|align\\*|equation|equation\\*|gather|gather\\*|multline|multline\\*|cases|center)\\})": {
            "filterFileRegex": ".*\\.(md)$",
            "regexFlags": "gm",
            "decorations": [
                {
                    "fontWeight": "bold",
                    "light": {
                        "color": "firebrick"
                    },
                    "dark": {
                        "color": "salmon"
                    }
                },
                {
                    "light": {},
                    "dark": {},
                    "isWholeLine": true
                },
                {
                    "fontWeight": "bold",
                    "light": {
                        "color": "firebrick"
                    },
                    "dark": {
                        "color": "salmon"
                    }
                }
            ]
        }
    }
}
