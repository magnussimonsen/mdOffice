{
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python",
    "emeraldwalk.runonsave": {
        "isEnabled": true,
        "commands": [
            {
                "match": ".*",
                "cmd": "echo '${fileBasename}' saved."
            },
            {
                "match": ".*\\.md$",
                "cmd": "\"${workspaceFolder}/.venv/bin/python\" \"${workspaceFolder}/_core/scripts/mdoffice.py\" build-all \"${file}\""
            },
            {
                "match": ".*\\.md$",
                "cmd": "\"${workspaceFolder}/.venv/bin/python\" \"${workspaceFolder}/_core/scripts/mdoffice.py\" build-ai-instructions \"${file}\""
            }
        ]
    }
}
